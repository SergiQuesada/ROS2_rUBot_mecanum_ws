<?xml version="1.0"?>
<launch>

    <!-- Parameters for holonomic self-control -->
    <arg name="distance_limit" default="0.1"/>
    <arg name="speed_factor" default="1.0"/>
    <arg name="forward_speed" default="0.2"/>
    <arg name="strafe_speed" default="0.2"/>   <!-- NEW holonomic parameter -->
    <arg name="rotation_speed" default="0.5"/> <!-- Not used in holonomic control -->
    <arg name="time_to_stop" default="10.0"/>

    <node
        pkg="my_robot_control"
        exec="my_robot_selfcontrol_holonomic_exec"
        name="robot_selfcontrol_holonomic"
        output="screen">

        <param name="distance_limit" value="$(var distance_limit)"/>
        <param name="speed_factor" value="$(var speed_factor)"/>
        <param name="forward_speed" value="$(var forward_speed)"/>
        <param name="strafe_speed" value="$(var strafe_speed)"/> 
        <param name="rotation_speed" value="$(var rotation_speed)"/>
        <param name="time_to_stop" value="$(var time_to_stop)"/>

    </node>

</launch>
